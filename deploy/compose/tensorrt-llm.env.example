# TensorRT-LLM direct compatibility evaluation on one NVIDIA PC.
#
# Copy this file to an ignored operator-owned path and replace every pin and
# credential before treating a run as retained evidence.
COMPOSE_PROJECT_NAME=ax-serving-trtllm-eval

# AX gateway <-> runtime-agent evaluation credentials.
AXS_DISPATCH_TOKEN=replace-this-evaluation-dispatch-token
AXS_WORKER_TOKEN=replace-this-evaluation-worker-token
AXS_DEPLOYMENT_MODE=legacy_compat

# Exact runtime identity registered by ax-runtime-agent.
AXS_NODE_RUNTIME=tensorrt_llm
AXS_RUNTIME_VERSION=1.3.0rc23
AXS_NODE_RUNTIME_URL=http://tensorrt-llm:8000
AXS_NODE_RUNTIME_HEALTH_PATH=/v1/models
AXS_NODE_ID=trtllm-pc-01
AXS_NODE_WORKER_POOL=trtllm-pc
AXS_NODE_CLASS=nvidia-pc
AXS_NODE_HARDWARE_CLASS=pc-cuda-sm120
AXS_NODE_MAX_INFLIGHT=8
AXS_NODE_SHUTDOWN_TIMEOUT_SECS=30

# The digest below is the exact linux/amd64 image qualified by the example
# run. Re-pin deliberately for another architecture or release.
TRTLLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:1.3.0rc23@sha256:316b840a08a8174fc3f6b5716828bdfe1daaf629ee1ac2a8b7a22526d141a007
TRTLLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
TRTLLM_MODEL_REVISION=fe8a4ea1ffedaf415f4da2f062534de366a451e6
TRTLLM_SERVED_MODEL=tinyllama-trtllm
TRTLLM_HOST_PORT=8000
TRTLLM_MAX_BATCH_SIZE=8
TRTLLM_MAX_NUM_TOKENS=2048
TRTLLM_MAX_SEQ_LEN=2048
TRTLLM_HF_CACHE_VOLUME=trtllm-hf-cache
