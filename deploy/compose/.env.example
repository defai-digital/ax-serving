# Copy to .env and replace operator-owned values. These are evaluation
# placeholders, not production credentials.
AXS_DISPATCH_TOKEN=replace-this-evaluation-dispatch-token
AXS_WORKER_TOKEN=replace-this-evaluation-worker-token
AXS_DEPLOYMENT_MODE=legacy_compat
AXS_NODE_RUNTIME_URL=http://host.docker.internal:8000
AXS_NODE_RUNTIME_HEALTH_PATH=/health
AXS_NODE_RUNTIME=vllm
AXS_RUNTIME_VERSION=replace-with-pinned-version
AXS_NODE_ID=runtime-agent-compose-1
AXS_NODE_WORKER_POOL=compose-compat
AXS_NODE_CLASS=generic
AXS_NODE_HARDWARE_CLASS=cpu
AXS_NODE_MAX_INFLIGHT=4
AXS_NODE_SHUTDOWN_TIMEOUT_SECS=30
