# SGLang direct compatibility evaluation on one NVIDIA PC.
# Copy to an ignored operator-owned file before running the profile.
COMPOSE_PROJECT_NAME=ax-serving-sglang-eval

AXS_DISPATCH_TOKEN=replace-this-evaluation-dispatch-token
AXS_WORKER_TOKEN=replace-this-evaluation-worker-token
AXS_DEPLOYMENT_MODE=legacy_compat

AXS_NODE_RUNTIME=sglang
AXS_RUNTIME_VERSION=0.5.12.post1
AXS_NODE_RUNTIME_URL=http://sglang:30000
AXS_NODE_RUNTIME_HEALTH_PATH=/v1/models
AXS_NODE_ID=sglang-pc-01
AXS_NODE_WORKER_POOL=sglang-pc
AXS_NODE_CLASS=nvidia-pc
AXS_NODE_HARDWARE_CLASS=pc-cuda-sm120
AXS_NODE_MAX_INFLIGHT=8
AXS_NODE_SHUTDOWN_TIMEOUT_SECS=30

# Qualified linux/amd64 image and public TinyLlama checkpoint.
SGLANG_IMAGE=lmsysorg/sglang:v0.5.12.post1@sha256:0b9ebdd8fbb659500a4abfe8541049923dc768088e0e36cf8bffe8f3728f6f9a
SGLANG_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
SGLANG_MODEL_REVISION=fe8a4ea1ffedaf415f4da2f062534de366a451e6
SGLANG_SERVED_MODEL=tinyllama-sglang
SGLANG_HOST_PORT=8002
SGLANG_CONTEXT_LENGTH=2048
SGLANG_MAX_RUNNING_REQUESTS=8
SGLANG_MEM_FRACTION_STATIC=0.50
RUNTIME_HF_CACHE_VOLUME=ax-serving-runtime-hf-cache
