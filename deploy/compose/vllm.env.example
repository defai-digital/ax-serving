# vLLM direct compatibility evaluation on one NVIDIA PC.
# Copy to an ignored operator-owned file before running the profile.
COMPOSE_PROJECT_NAME=ax-serving-vllm-eval

AXS_DISPATCH_TOKEN=replace-this-evaluation-dispatch-token
AXS_WORKER_TOKEN=replace-this-evaluation-worker-token
AXS_DEPLOYMENT_MODE=legacy_compat

AXS_NODE_RUNTIME=vllm
AXS_RUNTIME_VERSION=0.25.1
AXS_NODE_RUNTIME_URL=http://vllm:8000
AXS_NODE_RUNTIME_HEALTH_PATH=/v1/models
AXS_NODE_ID=vllm-pc-01
AXS_NODE_WORKER_POOL=vllm-pc
AXS_NODE_CLASS=nvidia-pc
AXS_NODE_HARDWARE_CLASS=pc-cuda-sm120
AXS_NODE_MAX_INFLIGHT=8
AXS_NODE_SHUTDOWN_TIMEOUT_SECS=30

# Qualified linux/amd64 image and public TinyLlama checkpoint.
VLLM_IMAGE=vllm/vllm-openai:v0.25.1@sha256:f0b9a0dc75a9fca3b6811e3279367b2d6a448055a000bfd13859587d74cef268
VLLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
VLLM_MODEL_REVISION=fe8a4ea1ffedaf415f4da2f062534de366a451e6
VLLM_SERVED_MODEL=tinyllama-vllm
VLLM_HOST_PORT=8001
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=8
VLLM_GPU_MEMORY_UTILIZATION=0.50
RUNTIME_HF_CACHE_VOLUME=ax-serving-runtime-hf-cache
VLLM_COMPILE_CACHE_VOLUME=ax-serving-vllm-compile-cache
