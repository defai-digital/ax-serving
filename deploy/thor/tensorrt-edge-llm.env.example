# Copy to an ignored operator-owned file on each Thor.
COMPOSE_PROJECT_NAME=ax-serving-edge-llm-thor

# Gateway internal registration endpoint and shared evaluation credentials.
AXS_CONTROL_PLANE_URL=http://192.168.2.91:19090
AXS_DISPATCH_TOKEN=replace-this-evaluation-dispatch-token
AXS_WORKER_TOKEN=replace-this-evaluation-worker-token
AXS_TLS_PROFILE=trusted_mesh

# Set these to the SSH alias target, not the machine's potentially stale hostname.
AXS_NODE_ID=df-thor-01-edge-llm
AXS_NODE_FRIENDLY_NAME=df-thor-01
AXS_NODE_ADVERTISED_URL=http://192.168.2.61:18081
AXS_NODE_DOMAIN_ID=df-thor-01-edge-llm
AXS_NODE_WORKER_POOL=tensorrt-edge-llm-thor
EDGE_LLM_PORT=8000
