{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/defai-digital/ax-serving/integrations/nvidia/compatibility-manifest.schema.json",
  "title": "AX Serving Dynamo compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain_kind",
    "dynamo",
    "components",
    "backend",
    "platform",
    "graph_config_digest",
    "model_certifications",
    "issued_at",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "domain_kind": {
      "enum": ["nvidia_dynamo_pc", "nvidia_dynamo_thor"]
    },
    "dynamo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit", "release_url"],
      "properties": {
        "repository": {
          "const": "https://github.com/ai-dynamo/dynamo"
        },
        "tag": {"type": "string", "minLength": 1, "maxLength": 128},
        "commit": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
        "release_url": {"type": "string", "format": "uri"}
      }
    },
    "components": {
      "type": "object",
      "minProperties": 2,
      "required": ["frontend", "runtime"],
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._:+/-]{1,128}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\S+@sha256:[0-9A-Fa-f]{64}$"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "os", "cuda"],
      "properties": {
        "arch": {"enum": ["amd64", "x86_64", "arm64", "aarch64"]},
        "os": {"type": "string", "minLength": 1, "maxLength": 128},
        "cuda": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "graph_config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9A-Fa-f]{64}$"
    },
    "model_certifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9A-Fa-f]{64}$"
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "string", "minLength": 1, "maxLength": 2048}
  }
}
