# One runtime-neutral adapter for one complete Mac AX Engine cluster.
AXS_MAC_CLUSTER_DOMAIN_ID=mac-cluster-main
AXS_MAC_CLUSTER_ADAPTER_ID=mac-cluster-mac-cluster-main
AXS_MAC_CLUSTER_POOL_ID=mac-cluster
AXS_MAC_CLUSTER_TRUST_DOMAIN=private-lab
AXS_MAC_CLUSTER_QUALIFICATION=experimental
AXS_MAC_CLUSTER_HARDWARE_CLASS=apple-silicon-cluster

AXS_MAC_CLUSTER_MANIFEST_PATH=config/mac-cluster-manifest.example.json
AXS_MAC_CLUSTER_RANK0_URL=http://127.0.0.1:18100
AXS_MAC_CLUSTER_LISTEN_ADDR=127.0.0.1:18083
AXS_MAC_CLUSTER_ADVERTISED_URL=http://127.0.0.1:18083
AXS_CONTROL_PLANE_URL=http://127.0.0.1:19090

# Supply independent values through a secret manager in production.
AXS_WORKER_TOKEN=replace-with-worker-control-token
AXS_DISPATCH_TOKEN=replace-with-gateway-dispatch-token
AXS_MAC_CLUSTER_CONTROL_TOKEN=replace-with-rank-control-token
# For loopback development only, dispatch auth may instead be disabled explicitly:
# AXS_TLS_PROFILE=loopback_dev
# AXS_ALLOW_NO_AUTH=true

AXS_MAC_CLUSTER_MAX_INFLIGHT=2
AXS_MAC_CLUSTER_RANK_STALE_MS=15000
AXS_MAC_CLUSTER_DRAIN_TIMEOUT_SECS=300
