# One adapter represents one complete Dynamo execution domain.
AXS_CONTROL_PLANE_URL=https://ax-serving-control.internal
AXS_DYNAMO_DOMAIN_ID=nvidia-pc-main
AXS_DYNAMO_DOMAIN_KIND=nvidia_dynamo_pc
AXS_DYNAMO_FRONTEND_URL=https://dynamo-frontend.internal
AXS_DYNAMO_MANIFEST_PATH=/etc/ax-serving/dynamo-compatibility-manifest.json
AXS_DYNAMO_ADAPTER_ID=dynamo-nvidia-pc-main
AXS_DYNAMO_POOL_ID=nvidia-pc
AXS_DYNAMO_TRUST_DOMAIN=private-dc
AXS_DYNAMO_QUALIFICATION=experimental
AXS_DYNAMO_HARDWARE_CLASS=nvidia-pc-cuda
AXS_DYNAMO_LISTEN_ADDR=0.0.0.0:18082
AXS_DYNAMO_ADVERTISED_URL=https://ax-dynamo-adapter.internal
AXS_DYNAMO_PROBE_INTERVAL_MS=5000
AXS_DYNAMO_DRAIN_TIMEOUT_SECS=300
AXS_DYNAMO_MAX_INFLIGHT=64
AXS_TLS_PROFILE=trusted_mesh

# Supply these through a secret manager, not this file:
# AXS_WORKER_TOKEN
# AXS_DISPATCH_TOKEN
# AXS_DYNAMO_API_KEY
